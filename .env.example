# Environment variables (placeholder values only — copy to .env for local use)

# Base URL for the Yeetcraft HTTP API (not used until upload is implemented).
YEETCRAFT_API_BASE_URL=https://example.com/api

# API key for authenticated writes to Yeetcraft (not used until upload is implemented).
YEETCRAFT_API_KEY=your-api-key-here

# Required for production capture: comma-separated Player- prefixed character GUIDs to track.
YEETCRAFT_TRACKED_GUIDS=Player-0001-00000001

# IANA timezone for timezone-less combat-log timestamps (for example America/New_York).
WOW_LOG_TIMEZONE=America/New_York

# Optional diagnostics-only installation identifier (never a hash input or credential).
COMPANION_INSTALLATION_ID=install-example-id

# Optional override for the WoW combat-log directory (not used until log watching is implemented).
# WOW_COMBAT_LOG_DIR=C:\Program Files (x86)\World of Warcraft\_retail_\Logs

# Optional path for the companion's local SQLite database (not used until storage is implemented).
# COMPANION_DB_PATH=./data/companion.db

# Log level for companion diagnostics: debug, info, warn, error (not used yet).
LOG_LEVEL=info
